# ============================================
# ENVIRONMENT SWITCH
# ============================================
# Set to 'development' or 'production' to switch between environments
# This automatically selects the correct URLs below
VITE_ENVIRONMENT=development

# ============================================
# DEVELOPMENT URLs
# ============================================
VITE_APP_URL_DEV=https://demo.q8basket.com
VITE_API_BASE_URL_DEV=https://demo.q8basket.com/api
VITE_BACKEND_URL_DEV=https://demo.q8basket.com/api

# ============================================
# PRODUCTION URLs
# ============================================
VITE_APP_URL_PROD=https://app.q8basket.com
VITE_API_BASE_URL_PROD=https://app.q8basket.com/api
VITE_BACKEND_URL_PROD=https://app.q8basket.com/api

# ============================================
# ACTIVE URLs (Auto-selected based on VITE_ENVIRONMENT)
# ============================================
# These are automatically set based on VITE_ENVIRONMENT above
# You can also override them manually if needed
VITE_APP_URL=
VITE_API_BASE_URL=
VITE_BACKEND_URL=

# ============================================
# EXTERNAL SERVICES (Same for all environments)
# ============================================
VITE_OPENSTREETMAP_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_OPENSTREETMAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# CDN URLs
VITE_UNSPLASH_CDN_URL=https://images.unsplash.com
VITE_FLATICON_CDN_URL=https://cdn-icons-png.flaticon.com

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Web Client ID (for browser/PWA)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id-here
# Mobile Client ID (for Android/iOS app - use Android client ID)
VITE_GOOGLE_CLIENT_ID_MOBILE=your-google-mobile-client-id-here