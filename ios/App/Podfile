require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorCamera', :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorNetwork', :path => '../../node_modules/@capacitor/network'
  pod 'CapacitorPreferences', :path => '../../node_modules/@capacitor/preferences'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
  pod 'CapgoCapacitorSocialLogin', :path => '../../node_modules/@capgo/capacitor-social-login'
end

target 'Q8Basket' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # Silence deprecation + Swift warnings in all pod targets (SFAuthenticationSession, openURL:, etc.)
  deprecated_flags = ['-Wno-deprecated-declarations', '-Wno-deprecated-implementations']
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      config.build_settings['GCC_WARN_DEPRECATED_FUNCTIONS'] = 'NO'
      # Allow GoogleSignIn/GTMAppAuth double-quoted includes in framework headers (required for use_frameworks!)
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      # Ensure pod targets inherit header search paths so GTMAppAuth finds GTMSessionFetcher
      config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited)'
      # Compiler flags to suppress deprecated API warnings
      cflags = config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
      config.build_settings['OTHER_CFLAGS'] = (cflags.is_a?(Array) ? cflags : [cflags]) + deprecated_flags
      cxxflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = (cxxflags.is_a?(Array) ? cxxflags : [cxxflags]) + deprecated_flags
      # Suppress Swift warnings
      flags = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
      config.build_settings['OTHER_SWIFT_FLAGS'] = "#{flags} -suppress-warnings".strip
    end
  end
  # Keep sandboxing disabled for Pods (CocoaPods scripts need broader file access)
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
  end
  # Apply same quoted-include / non-modular settings to app target so it can import GoogleSignIn
  project_path = installer.aggregate_targets.find { |t| t.name == 'Pods-Q8Basket' }&.user_project&.path
  project_path ||= File.join(__dir__, 'App.xcodeproj')
  if File.exist?(project_path)
    require 'xcodeproj'
    project = Xcodeproj::Project.open(project_path)
    project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
    project.save
  end

  # Inject privacy manifest into Google Sign-In–related pods (ITMS-91061)
  privacy_manifest_path = File.join(__dir__, 'PrivacyManifests', 'PrivacyInfo.xcprivacy')
  if File.exist?(privacy_manifest_path)
    pods_project = installer.pods_project
    rel_path = '../PrivacyManifests/PrivacyInfo.xcprivacy'
    file_ref = pods_project.main_group.recursive_children.find { |c| c.respond_to?(:path) && c.path == rel_path }
    file_ref ||= pods_project.main_group.new_file(rel_path)
    %w[GTMAppAuth GTMSessionFetcher GoogleSignIn].each do |target_name|
      target = pods_project.targets.find { |t| t.name == target_name }
      next unless target
      phase = target.resources_build_phase
      next if phase.files.any? { |bf| bf.file_ref&.path&.include?('PrivacyInfo') }
      phase.add_file_reference(file_ref)
    end
    pods_project.save
  end
end

# Runs AFTER CocoaPods integrates the project (so our changes persist)
post_integrate do |installer|
  require 'xcodeproj'
  agg = installer.aggregate_targets.find { |t| t.name == 'Pods-Q8Basket' }
  project_path = agg&.user_project&.path || File.join(__dir__, 'App.xcodeproj')
  project = Xcodeproj::Project.open(project_path)
  project.native_targets.each do |target|
    target.build_phases.grep(Xcodeproj::Project::Object::PBXShellScriptBuildPhase).each do |phase|
      if phase.name == '[CP] Embed Pods Frameworks' && phase.output_paths.empty?
        phase.output_paths << '${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/Pods_Q8Basket.framework'
        phase.input_paths << '${PODS_ROOT}/Target Support Files/Pods-Q8Basket/Pods-Q8Basket-frameworks.sh'
        phase.input_paths << '${BUILT_PRODUCTS_DIR}/Pods_Q8Basket.framework'
      end
    end
  end
  project.save
end
