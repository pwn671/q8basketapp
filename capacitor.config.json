{
  "appId": "com.q8basket.app",
  "appName": "Q8Basket",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "appendUserAgent": " Q8BasketApp",
    "backgroundColor": "#ffffff",
    "allowNavigation": [
      "http://localhost:*",
      "https://localhost:*",
      "https://accounts.google.com/*",
      "https://accounts.youtube.com/*",
      "https://*.google.com/*",
      "https://*.googleapis.com/*",
      "https://app.q8basket.com/*",
      "https://demo.q8basket.com/*"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "light",
      "backgroundColor": "transparent",
      "overlaysWebView": true
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "948766176517-cg6a06l9u1i161uiiabocrj8538vp3tr.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    }
  }
}
